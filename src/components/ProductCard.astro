---
import type { Product } from '../data/products';
import { slugify } from '../data/products';

type Props = Product;

const { name, price, category, image } = Astro.props;
---

<a
  href={`/produtos/${slugify(name)}`}
  class="bg-creme border border-[#f4d4c6] rounded-3xl overflow-hidden flex flex-col min-w-0 w-full text-left cursor-pointer transition-[border-color,transform] duration-200 hover:border-terra hover:rotate-2"
>
  <div class="relative h-44 w-full bg-[#e8dbbf] shrink-0">
    {image
      ? <img src={image} alt={name} class="absolute inset-0 w-full h-full object-cover" />
      : <div class="absolute inset-0 bg-[#e8dbbf]"></div>
    }
    <span class="absolute top-3 right-4 bg-[rgba(255,247,232,0.9)] text-grafite text-[10px] font-semibold tracking-[0.05em] px-3 py-1.5 rounded-full">
      {category}
    </span>
  </div>

  <div class="flex flex-col gap-1.5 p-5">
    <p class="font-bold text-base text-grafite leading-snug">{name}</p>
    <p class="font-bold text-lg text-terra leading-snug">{price}</p>
  </div>
</a>
