---
import type { Product } from '../data/products';
import { slugify } from '../data/products';

type Props = Product;

const { name, price, image, variants } = Astro.props;
const hasMultipleVariants = (variants?.length ?? 0) > 1;
const baseQuantity = variants?.[0]?.quantity;
---

<a href={`/produtos/${slugify(name)}`} class="flex flex-col gap-2.5 group min-w-0">
  <div class="aspect-square rounded-2xl overflow-hidden bg-[#e8dbbf]">
    {
      image && (
        <img
          src={image}
          alt={name}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
        />
      )
    }
  </div>
  <div class="min-w-0">
    <p class="text-sm font-semibold text-grafite leading-snug truncate">{name}</p>
    <p class="text-sm font-bold text-terra leading-snug">
      {hasMultipleVariants && <span class="font-medium text-xs text-grafite/60">a partir de </span>}
      {price}
    </p>
    {
      baseQuantity && (
        <p class="text-[11px] text-grafite/50 leading-snug">lote de {baseQuantity} unidades</p>
      )
    }
  </div>
</a>
