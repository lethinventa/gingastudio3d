---
const navLinks = [
  { label: 'Início', href: '/' },
  { label: 'Produtos', href: '/produtos' },
  { label: 'Serviços', href: '/produtos' },
  { label: 'Sobre', href: '/#sobre' },
  { label: 'Contato', href: '/#contato' },
];

const helpLinks = [
  { label: 'Perguntas frequentes', href: '/#sobre' },
  { label: 'Prazos e envios', href: '/#como-funciona' },
  { label: 'Trocas e devoluções', href: '/#contato' },
  { label: 'Política de privacidade', href: '/politica-de-privacidade' },
];
---

<footer class="w-full bg-creme border-t border-black/8">
  <div class="max-w-7xl mx-auto px-6 py-12 flex flex-col gap-10 md:flex-row md:justify-between">
    <div class="flex flex-col gap-3 max-w-64">
      <a href="/" aria-label="Ginga Studio 3D">
        <img src="/logo.png" alt="Ginga Studio 3D" class="h-9 w-auto" />
      </a>
      <p class="text-grafite/70 text-sm leading-relaxed">
        Impressão 3D feita em Natal/RN com criatividade e muita ginga.
      </p>
    </div>

    <div class="flex flex-wrap gap-12 md:gap-16">
      <div class="flex flex-col gap-3">
        <p class="text-grafite font-semibold text-sm">Navegação</p>
        {
          navLinks.map(({ label, href }) => (
            <a href={href} class="text-grafite/70 text-sm hover:text-azul transition-colors">
              {label}
            </a>
          ))
        }
      </div>

      <div class="flex flex-col gap-3">
        <p class="text-grafite font-semibold text-sm">Ajuda</p>
        {
          helpLinks.map(({ label, href }) => (
            <a href={href} class="text-grafite/70 text-sm hover:text-azul transition-colors">
              {label}
            </a>
          ))
        }
      </div>

      <div class="flex flex-col gap-3">
        <p class="text-grafite font-semibold text-sm">Nos acompanhe</p>
        <div class="flex gap-3">
          <a
            href="https://www.instagram.com/gingastudio.3d"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-9 h-9 rounded-full border border-black/15 flex items-center justify-center text-grafite hover:border-azul hover:text-azul transition-colors"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <a
            href="https://www.tiktok.com/@ginga.studio"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="w-9 h-9 rounded-full border border-black/15 flex items-center justify-center text-grafite hover:border-azul hover:text-azul transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M16.5 2h-3v13.5a2.5 2.5 0 11-2-2.45V10a5.5 5.5 0 105.5 5.5V8.9a6.4 6.4 0 003.5 1.04V7a3.5 3.5 0 01-4-5z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-black/8">
    <div
      class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-2"
    >
      <p class="text-grafite/60 text-xs">© 2024 Ginga Studio 3D. Todos os direitos reservados.</p>
      <p class="text-grafite/60 text-xs">Desenvolvido com ginga em Natal/RN</p>
    </div>
  </div>
</footer>
