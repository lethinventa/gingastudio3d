---
---

<section class="w-full py-8 md:py-16 px-6">
  <div class="max-w-7xl mx-auto">
    <div
      class="bg-[#f6ead9] rounded-3xl overflow-hidden flex flex-col md:flex-row items-center gap-10 px-8 py-10 md:px-16 md:py-14"
    >
      <div class="flex-1 flex flex-col gap-4">
        <h2 class="text-grafite text-3xl lg:text-[32px] font-semibold tracking-[-0.04em] leading-tight">
          Fale com a gente pelo <span class="text-azul">WhatsApp</span>
        </h2>
        <p class="text-grafite/70 text-sm leading-relaxed max-w-sm">
          Tire dúvidas, faça pedidos personalizados e acompanhe seu pedido.
        </p>
        <a
          href="https://wa.me/5584999999999"
          target="_blank"
          rel="noopener noreferrer"
          class="self-start inline-flex items-center gap-2.5 bg-azul text-creme font-bold text-sm px-5 py-3 rounded-full hover:opacity-90 transition-opacity"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.07L2 22l5.06-1.33A9.94 9.94 0 0012 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18a7.9 7.9 0 01-4.03-1.1l-.29-.17-3 .79.8-2.92-.19-.3A7.93 7.93 0 014 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8zm4.4-5.98c-.24-.12-1.43-.7-1.65-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.18-.71-.63-1.19-1.41-1.33-1.65-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.32-.75-1.81-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.43-.58 1.63-1.15.2-.57.2-1.05.14-1.15-.06-.1-.22-.16-.46-.28z"
            ></path>
          </svg>
          Chamar no WhatsApp
        </a>
      </div>

      <div class="flex-1 w-full md:w-auto hidden md:flex justify-center">
        <div class="w-56 rounded-[2rem] border-8 border-grafite bg-white shadow-xl overflow-hidden">
          <div class="bg-azul px-4 py-2.5 flex items-center gap-2">
            <div class="w-6 h-6 rounded-full bg-white/25"></div>
            <span class="text-white text-xs font-semibold">Ginga Studio 3D</span>
          </div>
          <div class="flex flex-col gap-2 p-3 bg-[#e9edf1] min-h-40">
            <div class="self-start bg-white rounded-xl rounded-tl-none px-3 py-2 text-[11px] text-grafite max-w-[85%] shadow-sm">
              Olá! 👋 Como podemos te ajudar hoje?
            </div>
            <div class="self-end bg-[#dcf3d4] rounded-xl rounded-tr-none px-3 py-2 text-[11px] text-grafite max-w-[85%] shadow-sm">
              Quero fazer um pedido personalizado!
            </div>
            <div class="self-start bg-white rounded-xl rounded-tl-none px-3 py-2 text-[11px] text-grafite max-w-[85%] shadow-sm">
              Perfeito! Vamos conversar sobre sua ideia 😊
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
