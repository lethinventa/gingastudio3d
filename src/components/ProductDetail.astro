---
import type { Product } from '../data/products';
import { installmentLabel } from '../lib/format';
import { productColors } from '../lib/colors';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, price, category, description, variants } = product;

const images = product.images?.length ? product.images : product.image ? [product.image] : [];
const hasVariantChoice = (variants?.length ?? 0) > 1;
const defaultVariant = variants?.[0];
---

<section class="w-full py-6 md:py-10 px-6">
  <div class="max-w-7xl mx-auto flex flex-col gap-6">
    <a
      href="/produtos"
      class="inline-flex items-center gap-1.5 self-start text-grafite/60 hover:text-azul transition-colors"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M8.75 2.91667L4.08333 7L8.75 11.0833"
          stroke="currentColor"
          stroke-width="1.16667"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="text-sm">Voltar</span>
    </a>

    <div class="flex flex-col lg:flex-row gap-10 lg:gap-14">
      <!-- Gallery -->
      <div class="flex-1 min-w-0">
        <div class="relative rounded-3xl overflow-hidden bg-[#e8dbbf] h-[340px] md:h-[460px]">
          {
            images[0] && (
              <img id="gallery-main-image" src={images[0]} alt={name} class="absolute inset-0 w-full h-full object-cover" />
            )
          }
          {
            images[0] && (
              <button
                id="gallery-expand"
                type="button"
                aria-label="Ver imagem em tamanho maior"
                class="absolute bottom-4 right-4 w-9 h-9 rounded-full bg-white/90 flex items-center justify-center hover:bg-white transition-colors"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                </svg>
              </button>
            )
          }
        </div>

        {
          images.length > 0 && (
            <div id="gallery-thumbnails" class="flex gap-2.5 pt-3 overflow-x-auto">
              {images.map((src, i) => (
                <button
                  type="button"
                  class={`gallery-thumb${i === 0 ? ' is-selected' : ''}`}
                  data-src={src}
                >
                  <img src={src} alt="" />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <!-- Info -->
      <div class="flex-1 min-w-0 flex flex-col gap-5">
        <div>
          <p class="text-azul text-[10px] font-bold tracking-[1.5px] uppercase leading-6">
            {category}
          </p>
          <h1 class="text-grafite text-4xl lg:text-[42px] font-semibold tracking-[-0.03em] leading-tight mt-1">
            {name}
          </h1>
          <p class="mt-3">
            <span id="detail-price" class="text-azul text-2xl font-bold leading-8">{defaultVariant?.price ?? price}</span>
            {
              defaultVariant && (
                <span id="detail-lote" class="text-grafite/50 text-lg font-medium">/{defaultVariant.quantity} und</span>
              )
            }
          </p>
          <p id="detail-installment" class="text-grafite/50 text-sm mt-1">{installmentLabel(defaultVariant?.price ?? price)}</p>
        </div>

        {
          description && (
            <p class="text-sm text-grafite/70 leading-relaxed max-w-lg">{description}</p>
          )
        }

        <div>
          <p class="text-[10px] font-bold tracking-[1.54px] uppercase text-grafite mb-2">
            Cor
          </p>
          <div id="color-selector" class="grid grid-cols-8 gap-2.5 max-w-[320px]">
            {productColors.map((c, i) => (
              <button
                type="button"
                class={`color-swatch${i === 0 ? ' is-selected' : ''}`}
                style={`background-color:${c.hex}`}
                data-label={c.label}
                aria-label={c.label}
                title={c.label}
              />
            ))}
            <button
              type="button"
              class="color-swatch color-swatch--other"
              data-label="Outra cor (combinar no WhatsApp)"
              aria-label="Outra cor"
              title="Outra cor"
            >
              +
            </button>
          </div>
          <p id="color-selected-label" class="text-xs text-grafite/60 mt-2">{productColors[0].label}</p>
        </div>

        <div>
          <p class="text-[10px] font-bold tracking-[1.54px] uppercase text-grafite mb-2">
            Personalização com logo
          </p>
          <div id="logo-toggle" class="inline-flex rounded-full border border-black/10 p-1">
            <button type="button" class="logo-option is-selected" data-value="nao">Não</button>
            <button type="button" class="logo-option" data-value="sim">Sim</button>
          </div>
          <p id="logo-note" class="text-xs text-grafite/60 mt-2" style="display:none">
            Valor da personalização combinado no WhatsApp, de acordo com a complexidade da arte.
          </p>
        </div>

        {
          hasVariantChoice && (
            <div>
              <p class="text-[10px] font-bold tracking-[1.54px] uppercase text-grafite mb-2">
                Tamanho do lote
              </p>
              <div id="variant-selector" class="flex flex-wrap gap-2">
                {variants!.map((variant, i) => (
                  <button
                    type="button"
                    class={`variant-option${i === 0 ? ' is-selected' : ''}`}
                    data-label={variant.label}
                    data-quantity={variant.quantity}
                    data-price={variant.price}
                  >
                    {variant.label}
                  </button>
                ))}
              </div>
            </div>
          )
        }

        <div>
          <p class="text-[10px] font-bold tracking-[1.54px] uppercase text-grafite mb-2">
            Quantidade
          </p>
          <div class="inline-flex items-center border border-black/10 rounded-full p-px">
            <button
              id="qty-minus"
              type="button"
              class="w-11 h-11 flex items-center justify-center text-grafite hover:text-azul transition-colors"
              aria-label="Diminuir quantidade"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M2.91667 7H11.0833" stroke="currentColor" stroke-width="1.16667" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <span id="qty-value" class="w-12 text-center font-medium text-grafite text-base">1</span>
            <button
              id="qty-plus"
              type="button"
              class="w-11 h-11 flex items-center justify-center text-grafite hover:text-azul transition-colors"
              aria-label="Aumentar quantidade"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M2.91667 7H11.0833" stroke="currentColor" stroke-width="1.16667" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M7 2.91667V11.0833" stroke="currentColor" stroke-width="1.16667" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="flex flex-col gap-3 pt-2">
          <button
            id="add-to-cart-btn"
            type="button"
            data-product={JSON.stringify({ name, price: defaultVariant?.price ?? price, image: images[0] ?? '' })}
            class="w-full bg-azul text-creme font-bold text-sm py-4 rounded-2xl flex items-center justify-center gap-2.5 hover:opacity-90 transition-opacity"
          >
            <span id="add-to-cart-label">Adicionar ao carrinho</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M5.33333 14.6667C5.70152 14.6667 6 14.3682 6 14C6 13.6318 5.70152 13.3333 5.33333 13.3333C4.96514 13.3333 4.66667 13.6318 4.66667 14C4.66667 14.3682 4.96514 14.6667 5.33333 14.6667Z"
                stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
              <path
                d="M12.6667 14.6667C13.0349 14.6667 13.3333 14.3682 13.3333 14C13.3333 13.6318 13.0349 13.3333 12.6667 13.3333C12.2985 13.3333 12 13.6318 12 14C12 14.3682 12.2985 14.6667 12.6667 14.6667Z"
                stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
              <path
                d="M1.36667 1.36667H2.7L4.47333 9.64667C4.53839 9.94991 4.70711 10.221 4.95047 10.4132C5.19383 10.6055 5.4966 10.7069 5.80667 10.7H12.3267C12.6301 10.6995 12.9243 10.5955 13.1607 10.4052C13.397 10.2149 13.5614 9.94969 13.6267 9.65333L14.7267 4.7H3.41333"
                stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<div
  id="image-lightbox"
  style="display:none"
  class="fixed inset-0 z-50 bg-black/80 items-center justify-center p-6"
>
  <button
    id="lightbox-close"
    type="button"
    aria-label="Fechar"
    class="absolute top-4 right-4 md:top-6 md:right-6 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  <img id="lightbox-image" src="" alt="" class="max-w-full max-h-full object-contain rounded-2xl" />
</div>

<style>
  .gallery-thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    border: 2px solid transparent;
    overflow: hidden;
    opacity: 0.5;
    cursor: pointer;
    transition:
      border-color 150ms,
      opacity 150ms;
  }

  .gallery-thumb.is-selected {
    border-color: var(--color-azul);
    opacity: 1;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .variant-option {
    border: 0.8px solid rgba(17, 17, 17, 0.25);
    color: #111;
    background: transparent;
    font-weight: 700;
    font-size: 13px;
    padding: 9px 17px;
    border-radius: 9999px;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 150ms,
      color 150ms,
      border-color 150ms;
  }

  .variant-option.is-selected {
    background: var(--color-azul);
    color: var(--color-creme);
    border-color: var(--color-azul);
  }

  .color-swatch {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    border: 2px solid rgba(17, 17, 17, 0.15);
    cursor: pointer;
    padding: 0;
    transition:
      transform 150ms,
      border-color 150ms,
      box-shadow 150ms;
  }

  .color-swatch:hover {
    transform: scale(1.08);
  }

  .color-swatch.is-selected {
    border-color: var(--color-azul);
    box-shadow: 0 0 0 2px var(--color-creme), 0 0 0 4px var(--color-azul);
  }

  .color-swatch--other {
    background: conic-gradient(
      from 180deg,
      #dc2626,
      #facc15,
      #4ade80,
      #1450a3,
      #7c3aed,
      #ec4899,
      #dc2626
    );
    border-style: dashed;
    color: var(--color-creme);
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }

  .logo-option {
    border: none;
    background: transparent;
    color: #111;
    font-weight: 700;
    font-size: 13px;
    padding: 8px 18px;
    border-radius: 9999px;
    cursor: pointer;
    transition:
      background-color 150ms,
      color 150ms;
  }

  .logo-option.is-selected {
    background: var(--color-azul);
    color: var(--color-creme);
  }
</style>

<script>
  import { addToCart, openCart } from '../lib/cart';
  import { slugify } from '../data/products';
  import { installmentLabel } from '../lib/format';

  const variantButtons = document.querySelectorAll<HTMLButtonElement>('.variant-option');
  const priceEl = document.getElementById('detail-price');
  const loteEl = document.getElementById('detail-lote');
  const installmentEl = document.getElementById('detail-installment');

  let selectedVariant: { label: string; quantity: number; price: string } | null =
    variantButtons.length > 0
      ? {
          label: variantButtons[0].dataset.label!,
          quantity: Number(variantButtons[0].dataset.quantity),
          price: variantButtons[0].dataset.price!,
        }
      : null;

  variantButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedVariant = {
        label: btn.dataset.label!,
        quantity: Number(btn.dataset.quantity),
        price: btn.dataset.price!,
      };
      variantButtons.forEach((b) => b.classList.toggle('is-selected', b === btn));
      if (priceEl) priceEl.textContent = selectedVariant.price;
      if (loteEl) loteEl.textContent = `/${selectedVariant.quantity} und`;
      if (installmentEl) installmentEl.textContent = installmentLabel(selectedVariant.price);
    });
  });

  const colorButtons = document.querySelectorAll<HTMLButtonElement>('.color-swatch');
  const colorLabelEl = document.getElementById('color-selected-label');
  let selectedColor = colorButtons[0]?.dataset.label ?? '';

  colorButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedColor = btn.dataset.label!;
      colorButtons.forEach((b) => b.classList.toggle('is-selected', b === btn));
      if (colorLabelEl) colorLabelEl.textContent = selectedColor;
    });
  });

  const logoButtons = document.querySelectorAll<HTMLButtonElement>('.logo-option');
  const logoNoteEl = document.getElementById('logo-note');
  let wantsLogo = false;

  logoButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      wantsLogo = btn.dataset.value === 'sim';
      logoButtons.forEach((b) => b.classList.toggle('is-selected', b === btn));
      if (logoNoteEl) logoNoteEl.style.display = wantsLogo ? '' : 'none';
    });
  });

  const mainImage = document.getElementById('gallery-main-image') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');

  thumbs.forEach((thumb, i) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.src;
      if (mainImage && src) mainImage.src = src;
      thumbs.forEach((t, j) => t.classList.toggle('is-selected', j === i));
    });
  });

  let quantity = 1;
  const qtyValueEl = document.getElementById('qty-value')!;

  function setQty(n: number) {
    quantity = Math.max(1, n);
    qtyValueEl.textContent = String(quantity);
  }

  document.getElementById('qty-minus')!.addEventListener('click', () => setQty(quantity - 1));
  document.getElementById('qty-plus')!.addEventListener('click', () => setQty(quantity + 1));

  const expandBtn = document.getElementById('gallery-expand');
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const lightboxClose = document.getElementById('lightbox-close');

  function openLightbox() {
    if (!lightbox || !lightboxImage || !mainImage) return;
    lightboxImage.src = mainImage.src;
    lightboxImage.alt = mainImage.alt;
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.style.display = 'none';
    document.body.style.overflow = '';
  }

  expandBtn?.addEventListener('click', openLightbox);
  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLightbox();
  });

  const addToCartBtn = document.getElementById('add-to-cart-btn')!;
  const addToCartLabel = document.getElementById('add-to-cart-label')!;

  addToCartBtn.addEventListener('click', () => {
    const product = JSON.parse(addToCartBtn.dataset.product!) as {
      name: string;
      price: string;
      image: string;
    };
    const baseSlug = slugify(product.name);
    const nameParts = [product.name];
    if (selectedVariant) nameParts.push(selectedVariant.label);
    if (selectedColor) nameParts.push(selectedColor);
    if (wantsLogo) nameParts.push('Com logo personalizado');
    const itemName = nameParts.join(' - ');

    const itemPrice = selectedVariant ? selectedVariant.price : product.price;

    const slugParts = [baseSlug];
    if (selectedVariant) slugParts.push(String(selectedVariant.quantity));
    if (selectedColor) slugParts.push(slugify(selectedColor));
    if (wantsLogo) slugParts.push('logo');
    const itemSlug = slugParts.join('--');

    addToCart({ slug: itemSlug, name: itemName, price: itemPrice, image: product.image }, quantity);

    const original = addToCartLabel.textContent;
    addToCartLabel.textContent = 'Adicionado ✓';
    setTimeout(() => {
      addToCartLabel.textContent = original;
    }, 1500);

    openCart();
  });
</script>
