---
import type { Product } from '../data/products';
import { installmentLabel } from '../lib/format';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, price, category, description, specs } = product;

const images = product.images?.length ? product.images : product.image ? [product.image] : [];
const materialBadge = specs?.['Materiais'] ?? 'PLA biodegradável';

const badges = [
  {
    label: materialBadge,
    icon: 'M12 3c-4 3-7 7-7 11a7 7 0 0014 0c0-4-3-8-7-11z M5 14c3 1 6 1 9-2',
  },
  {
    label: 'Produzido em Natal/RN',
    icon: 'M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z M12 13a2.5 2.5 0 100-5 2.5 2.5 0 000 5z',
  },
  {
    label: 'Envio em até 3 dias úteis',
    icon: 'M3 7h11v8H3z M14 10h4l3 3v2h-7z M6.5 19a1.5 1.5 0 100-3 1.5 1.5 0 000 3z M17.5 19a1.5 1.5 0 100-3 1.5 1.5 0 000 3z',
  },
  {
    label: 'Feito sob encomenda',
    icon: 'M12 3l2.4 5.5L20 9l-4.4 3.8L17 19l-5-3.3L7 19l1.4-6.2L4 9l5.6-.5z',
  },
  {
    label: 'Impressão 3D própria',
    icon: 'M12 3l8 4.5v9L12 21l-8-4.5v-9z M4 7.5l8 4.5 8-4.5 M12 12v9',
  },
  {
    label: 'Embalagem segura e sustentável',
    icon: 'M12 3l8 3.5v7c0 4.5-3.4 7.5-8 8.5-4.6-1-8-4-8-8.5v-7z',
  },
];
---

<section class="w-full py-6 md:py-10 px-6">
  <div class="max-w-7xl mx-auto flex flex-col gap-6">
    <a
      href="/produtos"
      class="inline-flex items-center gap-1.5 self-start text-grafite/60 hover:text-azul transition-colors"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M8.75 2.91667L4.08333 7L8.75 11.0833"
          stroke="currentColor"
          stroke-width="1.16667"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="text-sm">Voltar</span>
    </a>

    <div class="flex flex-col lg:flex-row gap-10 lg:gap-14">
      <!-- Gallery -->
      <div class="flex-1 min-w-0">
        <div class="relative rounded-3xl overflow-hidden bg-[#e8dbbf] h-[340px] md:h-[460px]">
          {
            images[0] && (
              <img id="gallery-main-image" src={images[0]} alt={name} class="absolute inset-0 w-full h-full object-cover" />
            )
          }
          {
            images[0] && (
              <a
                href={images[0]}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Ver imagem em tamanho maior"
                class="absolute bottom-4 right-4 w-9 h-9 rounded-full bg-white/90 flex items-center justify-center hover:bg-white transition-colors"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                </svg>
              </a>
            )
          }
        </div>

        {
          images.length > 1 && (
            <div id="gallery-thumbnails" class="flex gap-2.5 pt-3 overflow-x-auto">
              {images.map((src, i) => (
                <button
                  type="button"
                  class={`gallery-thumb${i === 0 ? ' is-selected' : ''}`}
                  data-src={src}
                >
                  <img src={src} alt="" />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <!-- Info -->
      <div class="flex-1 min-w-0 flex flex-col gap-5">
        <div>
          <p class="text-azul text-[10px] font-bold tracking-[1.5px] uppercase leading-6">
            {category}
          </p>
          <h1 class="text-grafite text-4xl lg:text-[42px] font-semibold tracking-[-0.03em] leading-tight mt-1">
            {name}
          </h1>
          <p class="text-azul text-2xl font-bold leading-8 mt-3">{price}</p>
          <p class="text-grafite/50 text-sm mt-1">{installmentLabel(price)}</p>
        </div>

        {
          description && (
            <p class="text-sm text-grafite/70 leading-relaxed max-w-lg">{description}</p>
          )
        }

        <div class="border-y border-black/10 py-5 grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-4">
          {
            badges.map(({ label, icon }) => (
              <div class="flex items-center gap-2.5">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="shrink-0 text-grafite/60"
                >
                  <path d={icon} />
                </svg>
                <span class="text-xs text-grafite/80 leading-snug">{label}</span>
              </div>
            ))
          }
        </div>

        <div>
          <p class="text-[10px] font-bold tracking-[1.54px] uppercase text-grafite mb-2">
            Quantidade
          </p>
          <div class="inline-flex items-center border border-black/10 rounded-full p-px">
            <button
              id="qty-minus"
              type="button"
              class="w-11 h-11 flex items-center justify-center text-grafite hover:text-azul transition-colors"
              aria-label="Diminuir quantidade"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M2.91667 7H11.0833" stroke="currentColor" stroke-width="1.16667" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <span id="qty-value" class="w-12 text-center font-medium text-grafite text-base">1</span>
            <button
              id="qty-plus"
              type="button"
              class="w-11 h-11 flex items-center justify-center text-grafite hover:text-azul transition-colors"
              aria-label="Aumentar quantidade"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M2.91667 7H11.0833" stroke="currentColor" stroke-width="1.16667" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M7 2.91667V11.0833" stroke="currentColor" stroke-width="1.16667" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="flex flex-col gap-3 pt-2">
          <button
            id="add-to-cart-btn"
            type="button"
            data-product={JSON.stringify({ name, price, image: images[0] ?? '' })}
            class="w-full bg-azul text-creme font-bold text-sm py-4 rounded-2xl flex items-center justify-center gap-2.5 hover:opacity-90 transition-opacity"
          >
            <span id="add-to-cart-label">Adicionar ao carrinho</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M5.33333 14.6667C5.70152 14.6667 6 14.3682 6 14C6 13.6318 5.70152 13.3333 5.33333 13.3333C4.96514 13.3333 4.66667 13.6318 4.66667 14C4.66667 14.3682 4.96514 14.6667 5.33333 14.6667Z"
                stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
              <path
                d="M12.6667 14.6667C13.0349 14.6667 13.3333 14.3682 13.3333 14C13.3333 13.6318 13.0349 13.3333 12.6667 13.3333C12.2985 13.3333 12 13.6318 12 14C12 14.3682 12.2985 14.6667 12.6667 14.6667Z"
                stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
              <path
                d="M1.36667 1.36667H2.7L4.47333 9.64667C4.53839 9.94991 4.70711 10.221 4.95047 10.4132C5.19383 10.6055 5.4966 10.7069 5.80667 10.7H12.3267C12.6301 10.6995 12.9243 10.5955 13.1607 10.4052C13.397 10.2149 13.5614 9.94969 13.6267 9.65333L14.7267 4.7H3.41333"
                stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>

          <button
            id="wishlist-btn"
            type="button"
            class="w-full bg-creme border border-black/10 text-grafite font-bold text-sm py-4 rounded-2xl flex items-center justify-center gap-2.5 hover:border-terra hover:text-terra transition-colors"
          >
            <span id="wishlist-label">Adicionar à lista de desejos</span>
            <svg id="wishlist-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path
                d="M12 21s-7.5-4.6-10-9.2C.5 8.6 2.2 5 5.8 5c2 0 3.4 1 6.2 3.8C14.8 6 16.2 5 18.2 5c3.6 0 5.3 3.6 3.8 6.8C19.5 16.4 12 21 12 21z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    border: 2px solid transparent;
    overflow: hidden;
    opacity: 0.5;
    cursor: pointer;
    transition:
      border-color 150ms,
      opacity 150ms;
  }

  .gallery-thumb.is-selected {
    border-color: var(--color-azul);
    opacity: 1;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  import { addToCart, openCart } from '../lib/cart';
  import { slugify } from '../data/products';

  const mainImage = document.getElementById('gallery-main-image') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');

  thumbs.forEach((thumb, i) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.src;
      if (mainImage && src) mainImage.src = src;
      thumbs.forEach((t, j) => t.classList.toggle('is-selected', j === i));
    });
  });

  let quantity = 1;
  const qtyValueEl = document.getElementById('qty-value')!;

  function setQty(n: number) {
    quantity = Math.max(1, n);
    qtyValueEl.textContent = String(quantity);
  }

  document.getElementById('qty-minus')!.addEventListener('click', () => setQty(quantity - 1));
  document.getElementById('qty-plus')!.addEventListener('click', () => setQty(quantity + 1));

  const addToCartBtn = document.getElementById('add-to-cart-btn')!;
  const addToCartLabel = document.getElementById('add-to-cart-label')!;

  addToCartBtn.addEventListener('click', () => {
    const product = JSON.parse(addToCartBtn.dataset.product!) as {
      name: string;
      price: string;
      image: string;
    };
    addToCart({ slug: slugify(product.name), name: product.name, price: product.price, image: product.image }, quantity);

    const original = addToCartLabel.textContent;
    addToCartLabel.textContent = 'Adicionado ✓';
    setTimeout(() => {
      addToCartLabel.textContent = original;
    }, 1500);

    openCart();
  });

  const wishlistBtn = document.getElementById('wishlist-btn')!;
  const wishlistIcon = document.getElementById('wishlist-icon')!;
  let wishlisted = false;

  wishlistBtn.addEventListener('click', () => {
    wishlisted = !wishlisted;
    wishlistIcon.setAttribute('fill', wishlisted ? 'currentColor' : 'none');
  });
</script>
