---
const steps = [
  {
    number: '01',
    title: 'Escolha seus produtos favoritos',
    body: 'Navegue pelo catálogo e encontre os brindes que você precisa.',
  },
  {
    number: '02',
    title: 'Adicione ao carrinho de compras',
    body: 'Escolha a quantidade e as personalizações e adicione os itens ao carrinho.',
  },
  {
    number: '03',
    title: 'Envie o pedido pelo WhatsApp',
    body: 'Clique em finalizar pedido e sua mensagem será gerada automaticamente.',
  },
  {
    number: '05',
    title: 'Produção sob encomenda',
    body: 'Fabricamos seus brindes com cuidado e qualidade garantida.',
  },
];
---

<section class="w-full py-8 md:py-16 px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {steps.map(({ number, title, body }, i) => (
      <div
        class="how-card group bg-azul rounded-3xl p-7 flex flex-col gap-8 cursor-default"
        style={`transition-delay: ${i * 100}ms`}
      >
        <span class="how-card__number text-sm font-light text-white/50">{number}</span>
        <div class="flex flex-col gap-2">
          <h3 class="font-bold text-white text-xl leading-snug">{title}</h3>
          <p class="text-white/70 text-sm leading-relaxed">{body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .how-card {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }

  .how-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .how-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 40px -12px color-mix(in oklch, var(--color-azul) 55%, transparent);
  }

  .how-card__number {
    display: inline-block;
    transition:
      color 0.35s ease,
      transform 0.35s ease;
  }

  .how-card:hover .how-card__number {
    color: color-mix(in oklch, white 90%, transparent);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .how-card {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .how-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll('.how-card');

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.2 }
  );

  cards.forEach((card) => observer.observe(card));
</script>
