<style>
  .pond {
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .fish-swim {
    left: -15%;
    animation: swim 7s ease-in-out infinite;
  }

  .fish-wag {
    animation: wag 1.2s step-end infinite;
    transform-origin: 50% 50%;
  }

  .fish-icon {
    display: block;
    transform: scaleX(-1);
  }

  @keyframes swim {
    0% {
      transform: translate(0, -6px);
    }
    25% {
      transform: translate(85px, 10px);
    }
    50% {
      transform: translate(170px, -10px);
    }
    75% {
      transform: translate(255px, 8px);
    }
    100% {
      transform: translate(340px, -6px);
    }
  }

  @keyframes wag {
    0% {
      transform: scaleY(-1) rotate(10deg);
    }
    50% {
      transform: scaleY(-1) rotate(-10deg);
    }
    100% {
      transform: scaleY(-1) rotate(10deg);
    }
  }

  .bubble {
    position: absolute;
    bottom: 10px;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: color-mix(in oklch, var(--color-azul) 25%, transparent);
    animation: rise 3.4s ease-in infinite;
  }

  .bubble--a {
    left: 30%;
    animation-delay: 0s;
  }

  .bubble--b {
    left: 55%;
    width: 4px;
    height: 4px;
    animation-delay: 1.1s;
  }

  .bubble--c {
    left: 70%;
    width: 5px;
    height: 5px;
    animation-delay: 2.1s;
  }

  @keyframes rise {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    100% {
      transform: translateY(-90px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fish-swim,
    .fish-wag,
    .bubble {
      animation: none;
    }

    .fish-swim {
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
