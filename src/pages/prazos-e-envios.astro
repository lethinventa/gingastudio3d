---
import '@fontsource-variable/onest/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    title: '1. Produção sob encomenda',
    body: 'Todos os produtos da Ginga Studio 3D são impressos sob encomenda. O prazo de produção varia de acordo com o tamanho do pedido (quantidade de peças e nível de personalização) — combinamos o prazo exato com você diretamente pelo WhatsApp, no momento da confirmação.',
  },
  {
    title: '2. Envio para outros estados',
    body: 'Para fora de Natal/RN, o envio é feito pelos Correios. O prazo de entrega dos Correios é somado ao prazo de produção do pedido.',
  },
  {
    title: '3. Entrega e retirada em Natal/RN',
    body: 'Para clientes em Natal, o pedido pode ser retirado no estúdio ou entregue por Uber moto. Nesse caso, o próprio cliente solicita e paga a corrida do Uber no momento da entrega.',
  },
  {
    title: '4. Acompanhamento do pedido',
    body: 'Como todo o atendimento é feito por WhatsApp, qualquer atualização sobre o andamento ou o prazo do seu pedido é combinada diretamente na conversa.',
  },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Prazos e Envios — Ginga Studio 3D</title>
  </head>
  <body>
    <Header />
    <main>
      <section class="w-full pt-10 md:pt-16 px-6">
        <div class="max-w-3xl mx-auto">
          <h1 class="text-grafite text-3xl lg:text-[42px] tracking-[-0.04em] leading-tight">
            <span class="font-light">Prazos e</span> <span class="font-semibold text-azul">envios</span>
          </h1>
          <p class="text-grafite/70 text-sm md:text-base mt-2">
            Como funciona a produção, o envio e a entrega dos pedidos da Ginga Studio 3D.
          </p>
        </div>
      </section>

      <section class="w-full py-8 md:py-12 px-6">
        <div class="max-w-3xl mx-auto flex flex-col gap-8">
          {sections.map(({ title, body }) => (
            <div class="flex flex-col gap-2">
              <h2 class="text-grafite font-semibold text-lg">{title}</h2>
              <p class="text-grafite/80 text-sm leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </section>
    </main>
    <CartDrawer />
    <Footer />
  </body>
</html>
