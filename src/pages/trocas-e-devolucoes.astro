---
import '@fontsource-variable/onest/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    title: '1. Quando aceitamos troca',
    body: 'Como os produtos são feitos sob encomenda e personalizados, a troca é aceita apenas em caso de defeito de fabricação da peça.',
  },
  {
    title: '2. Prazo para solicitar',
    body: 'Você tem até 15 dias corridos a partir do recebimento do pedido para solicitar a troca de uma peça com defeito.',
  },
  {
    title: '3. Como solicitar',
    body: 'Entre em contato pelo nosso WhatsApp com fotos do defeito e o número ou dados do pedido. A partir daí combinamos com você os próximos passos para a substituição da peça.',
  },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Trocas e Devoluções — Ginga Studio 3D</title>
  </head>
  <body>
    <Header />
    <main>
      <section class="w-full pt-10 md:pt-16 px-6">
        <div class="max-w-3xl mx-auto">
          <h1 class="text-grafite text-3xl lg:text-[42px] tracking-[-0.04em] leading-tight">
            <span class="font-light">Trocas e</span> <span class="font-semibold text-azul">devoluções</span>
          </h1>
          <p class="text-grafite/70 text-sm md:text-base mt-2">
            Como funciona a troca de peças com defeito na Ginga Studio 3D.
          </p>
        </div>
      </section>

      <section class="w-full py-8 md:py-12 px-6">
        <div class="max-w-3xl mx-auto flex flex-col gap-8">
          {sections.map(({ title, body }) => (
            <div class="flex flex-col gap-2">
              <h2 class="text-grafite font-semibold text-lg">{title}</h2>
              <p class="text-grafite/80 text-sm leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </section>
    </main>
    <CartDrawer />
    <Footer />
  </body>
</html>
