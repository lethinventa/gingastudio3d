---
import '@fontsource-variable/onest/wght.css';
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import ProductDetail from '../../components/ProductDetail.astro';
import ProductExtras from '../../components/ProductExtras.astro';
import ProductWhatsAppCTA from '../../components/ProductWhatsAppCTA.astro';
import Footer from '../../components/Footer.astro';
import { products, slugify } from '../../data/products';
import type { Product } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: slugify(product.name) },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{product.name} — Ginga Studio 3D</title>
  </head>
  <body>
    <Header />
    <main>
      <ProductDetail product={product} />
      <ProductExtras currentProduct={product} />
      <ProductWhatsAppCTA />
    </main>
    <Footer />
  </body>
</html>
